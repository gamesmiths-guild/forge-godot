[sub_resource type="Resource" id="Resource_entry_to_input"]
script = ExtResource("4_connection")
FromNode = "entry"
ToNode = "node_1"

[sub_resource type="Resource" id="Resource_input_to_commit"]
script = ExtResource("4_connection")
FromNode = "node_1"
OutputPort = 4
ToNode = "node_2"

[sub_resource type="Resource" id="Resource_commit_to_apply"]
script = ExtResource("4_connection")
FromNode = "node_2"
ToNode = "node_3"

[sub_resource type="Resource" id="Resource_entry"]
script = ExtResource("2_node")
NodeId = "entry"
Title = "Entry"
PositionOffset = Vector2(0, 200)

[sub_resource type="Resource" id="Resource_input"]
script = ExtResource("2_node")
NodeId = "node_1"
Title = "Input Action"
NodeType = 4
RuntimeTypeName = "Gamesmiths.Forge.Godot.Core.Statescript.Nodes.State.InputActionNode"
PositionOffset = Vector2(180, 160)
CustomData = Dictionary[String, Variant]({
"actionName": "ui_accept",
"deactivateOnPressed": false
})

[sub_resource type="Resource" id="Resource_commit"]
script = ExtResource("2_node")
NodeId = "node_2"
Title = "Try Commit Ability"
NodeType = 3
RuntimeTypeName = "Gamesmiths.Forge.Statescript.Nodes.Condition.TryCommitAbilityNode"
PositionOffset = Vector2(600, 200)
CustomData = Dictionary[String, Variant]({
"operation": "CostAndCooldown"
})

[sub_resource type="Resource" id="Resource_heal_effect"]
script = ExtResource("5_effect")
Effect = ExtResource("7_heal")

[sub_resource type="Resource" id="Resource_effect_binding"]
script = ExtResource("3_binding")
Resolver = SubResource("Resource_heal_effect")

[sub_resource type="Resource" id="Resource_owner"]
script = ExtResource("6_owner")

[sub_resource type="Resource" id="Resource_target_binding"]
script = ExtResource("3_binding")
PropertyIndex = 1
Resolver = SubResource("Resource_owner")

[sub_resource type="Resource" id="Resource_apply"]
script = ExtResource("2_node")
NodeId = "node_3"
Title = "Apply Effect"
NodeType = 2
RuntimeTypeName = "Gamesmiths.Forge.Statescript.Nodes.Action.ApplyEffectNode"
PositionOffset = Vector2(1020, 200)
PropertyBindings = Array[ExtResource("3_binding")]([SubResource("Resource_effect_binding"), SubResource("Resource_target_binding")])

[resource]
script = ExtResource("1_graph")
StatescriptName = "Heal"
Nodes = Array[ExtResource("2_node")]([SubResource("Resource_entry"), SubResource("Resource_input"), SubResource("Resource_commit"), SubResource("Resource_apply")])
Connections = Array[ExtResource("4_connection")]([SubResource("Resource_entry_to_input"), SubResource("Resource_input_to_commit"), SubResource("Resource_commit_to_apply")])
