<Project>

  <!--
    Forge for Godot. MSBuild imports this file automatically for the .csproj beside it, so installing
    the plugin requires no .csproj edit. It only forwards to addons/forge/Forge.props, which is where
    the package reference actually lives.

    If you already have a Directory.Build.props - either here or further up the tree - keep yours and
    add <Import Project="addons/forge/Forge.props" /> to it instead. MSBuild imports only the nearest
    one, so this file would otherwise silently shadow it.
  -->

  <Import Project="$(MSBuildThisFileDirectory)addons/forge/Forge.props" />

</Project>
