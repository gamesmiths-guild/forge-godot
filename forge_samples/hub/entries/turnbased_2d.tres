[resource]
script = ExtResource("1_entry")
Title = "Turn-Based 2D"
Tagline = "The same effects and durations, advanced one second per move."
Blurb = "A 2D scene focused on turn-based effects. Time only advances when you move, and each turn counts as one second, so damage and healing over time apply only as you act.

Useful for seeing how Forge's durations, periods and stacks behave outside a real-time loop."
Highlights = Array[String](["2D Areas, ShapeCasts and RayCasts", "The same effects and durations as the 3D demo", "Each turn advances one second", "Damage and healing over time apply only when you move", "Implements IForgeEntity directly instead of using the ForgeEntity node"])
Scene = ExtResource("2_level")
Accent = Color(0.556863, 0.486275, 0.764706, 1)
