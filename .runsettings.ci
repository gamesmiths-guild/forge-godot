<?xml version="1.0" encoding="utf-8"?>
<!--
  CI test settings. GODOT_BIN comes from the environment, which the workflow sets from the Godot it installed.
  Kept separate from the local .runsettings because that one hardcodes a developer's own Godot path.
-->
<RunSettings>
  <RunConfiguration>
    <MaxCpuCount>1</MaxCpuCount>
    <TestSessionTimeout>900000</TestSessionTimeout>
  </RunConfiguration>
  <GdUnit4>
    <Parameters>--headless</Parameters>
    <DisplayName>FullyQualifiedName</DisplayName>
    <CompileProcessTimeout>300000</CompileProcessTimeout>
    <GodotConnectTimeout>120000</GodotConnectTimeout>
  </GdUnit4>
</RunSettings>
