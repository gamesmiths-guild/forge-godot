[resource]
script = ExtResource("1_entry")
Title = "Quick Start"
Tagline = "The finished result of the Quick Start guide: a campfire that burns and a heal built as a graph."
Blurb = "Everything the Quick Start guide builds, step by step, in its finished form. Open it next to the guide to compare your own work.

Arrow keys move. Walk into the campfire to burn, walk out to stop. Press Space to heal: it costs 25 mana and has a 2 second cooldown, and mana comes back on its own."
Highlights = Array[String](["HeroAttributes is generated from a definition resource, not written by hand", "The campfire is an EffectArea2D with a periodic Burning effect, no graph and no code", "Burn and heal feedback are library cue handlers: particles, a flash and sound", "Heal is a four-node Statescript graph with a cost and a cooldown", "The only C# is arrow-key movement and the two attribute bars"])
Scene = ExtResource("2_level")
Accent = Color(0.45, 0.75, 1, 1)
