# Godot 4+ specific ignores
.godot/
/android/
.vs/

# Launch profile configs
/Properties/
*.user

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# gdUnit4 installs its test runner scene here on every run.
/gdunit4_testadapter_v5/

# Local test settings: pins this machine's Godot binary. Copy .runsettings.ci and set GODOT_BIN.
/.runsettings

# JUnit report from the editor test suite.
/TestResults/
