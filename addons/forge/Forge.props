<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LocalForgeProjectPath>$(MSBuildThisFileDirectory)..\..\..\forge\Forge\Forge.csproj</LocalForgeProjectPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(LocalForgeProjectPath)" Condition="Exists('$(LocalForgeProjectPath)')" />
    <!-- Statescript resources name Forge types by string, which a trimmed (NativeAOT) build would otherwise remove. -->
    <TrimmerRootAssembly Include="Gamesmiths.Forge" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(LocalForgeProjectPath)')">
    <PackageReference Include="Gamesmiths.Forge" Version="0.5.0" />
  </ItemGroup>
</Project>
